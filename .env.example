# ─────────────────────────────────────────────────────────────
# Low Religion — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# Postgres connection string (Supabase → Project Settings → Database)
# Prefer the pooled connection string for serverless deployments.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Razorpay (Dashboard → Settings → API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Razorpay webhook signing secret (Dashboard → Settings → Webhooks)
# Endpoint: https://www.lowreligion.com/api/webhooks/razorpay
# Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Canonical public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://lowreligion.com

# Merchandising: only these categories are purchasable (comma-separated).
# Every other category is shown blurred, without a price, and cannot be bought.
# These are PUBLIC vars, so they are baked in at build time — redeploy after changes.
NEXT_PUBLIC_SELLABLE_CATEGORIES=Accessories
# Badge shown on products that are not on sale yet.
NEXT_PUBLIC_COMING_SOON_LABEL=DROPPING SOON
# Replaces the price on those products.
NEXT_PUBLIC_COMING_SOON_PRICE_LABEL=Price revealed at drop

# Optional: Google Analytics 4 measurement ID (falls back to G-L9NZEQMD9F)
NEXT_PUBLIC_GA_ID=G-L9NZEQMD9F

# Optional: Google Search Console verification token
# Leave blank or omit to skip the meta tag.
GOOGLE_SITE_VERIFICATION=
